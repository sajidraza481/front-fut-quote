#!/usr/bin/env bash
# Blocks commits that contain secrets. Enabled by scripts/bootstrap.sh.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks)." >&2
  exit 1
fi

gitleaks git --staged --redact --no-banner --verbose
